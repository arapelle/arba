
# To generate svg: dot -Tsvg graph.gv > graph.svg

digraph G
{
#  rankdir = LR;
  graph [fontname = "helvetica"];
  node [style=radial, fillcolor="white:lightgreen"];
  node [fontname="monospace"; fontsize=13];
  edge [fontname="helvetica"];
  label = arba;
  # nodes
  cppx;core;dirn;evnt;hash;inis;meta;plug;rand;strn;math;uuid;aloc;itru;stdx;vlfs;wgen;grid;cryp;seri;rsce;appt
  TBB [style=radial, fillcolor="white:lightgrey"];spdlog [style=radial, fillcolor="white:lightgrey"]
  # arrows
# cppx:

# core:
core -> cppx
# dirn:
dirn -> cppx
# evnt:
evnt -> cppx
# hash:
hash -> cppx
# inis:
inis -> cppx
# meta:
meta -> cppx
# plug:
plug -> cppx
# rand:
rand -> cppx
# strn:
strn -> cppx
# math:
math -> meta
math -> hash
# uuid:
uuid -> hash
uuid -> rand
# aloc:
aloc -> meta
# itru:
itru -> meta
# stdx:
stdx -> meta
# vlfs:
vlfs -> strn
# wgen:
wgen -> strn
# grid:
grid -> math
# cryp:
cryp -> uuid
# seri:
seri -> core
seri -> uuid
# rsce:
rsce -> vlfs
# appt:
appt -> stdx
appt -> rsce
appt -> evnt
# cppx:

# core:

# dirn:

# evnt:

# hash:

